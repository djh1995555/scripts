@startuml
package ApaExecuteNewStartup{
    S0 --|> ApaExecuteNewStandStillSteering
    ApaExecuteNewStandStillSteering --|> ComputeControls
    ComputeControls --|> set_acc_by_ules
}

package ApaExecuteTracking{
    START --|> ComputeControls
    ComputeControls --|> set_acc_by_ules
}

package ApaExecuteObstacleTracking{
    START --|> ComputeControls
    ComputeControls --|> set_acc_by_ules
}

package ApaExecuteStopping{
    START --|> ComputeControls
    ComputeControls --|> set_acc_by_ules
}

package ApaExecuteNewStopping{
    START --|> ComputeControls
    ComputeControls --|> set_acc_by_ules
}

package Normal_stage{
    SEGMENT_INIT --|> SEGMENT_READY
    SEGMENT_READY --|> SEGMENT_EPB_RELEASE
    SEGMENT_EPB_RELEASE --|> SEGMENT_SWITCH_GEAR
    SEGMENT_SWITCH_GEAR --|> SEGMENT_STANDSTILL_STEERING
    SEGMENT_STANDSTILL_STEERING --|> SEGMENT_STARTUP

    SEGMENT_STARTUP --|> ApaExecuteNewStartup
    ApaExecuteNewStartup --|> SEGMENT_TRACKING
    SEGMENT_STARTUP --|> ApaExecuteNewStopping
    ApaExecuteNewStopping --|> SEGMENT_STOPPING
    note on link: small error
    SEGMENT_STARTUP --|> SEGMENT_STOPPING
    note on link: reach end point
    SEGMENT_STARTUP --|> SEGMENT_STARTUP
    note on link: else

    SEGMENT_TRACKING --|> ApaExecuteTracking
    ApaExecuteTracking --|> SEGMENT_FINISHED
    note on link: IsVehicleStuck
    ApaExecuteTracking --|> SEGMENT_STOPPING
    note on link: small error or reach end point
    ApaExecuteTracking --|> SEGMENT_STOPPING
    note on link: StopEmergencyIfExceedEndPoint

    SEGMENT_STOPPING --|> ApaExecuteNewStopping
    ApaExecuteNewStopping --|> StopEmergencyIfExceedEndPoint
    StopEmergencyIfExceedEndPoint --|> SEGMENT_STOPPING

    ApaExecuteNewStopping --|> ApaExecuteTracking
    ApaExecuteTracking --|> SEGMENT_TRACKING
    note on link: is_jump_tracking

    ApaExecuteNewStopping --|> ApaExecuteFinished
    ApaExecuteFinished --|> SEGMENT_FINISHED
    note on link: IsFullyStopped
}

Normal_stage --|> CheckVehicleGearNormal
CheckVehicleGearNormal --|> SEGMENT_ABNORMAL
SEGMENT_ABNORMAL --|> SEGMENT_INIT

Normal_stage --|> Collision_check
Collision_check --|> SEGMENT_EMERGENCY_STOPPING
SEGMENT_EMERGENCY_STOPPING --|> ApaExecuteStopping
ApaExecuteStopping --|> set_acc_by_ules
set_acc_by_ules --|> SEGMENT_FINISHED


@enduml